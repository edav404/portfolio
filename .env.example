# Copia este archivo como .env.local para desarrollo.
# En producción define estas variables en Coolify (Environment Variables).

# --- Público (se incrusta en el build; en Coolify márcala como "Build Variable") ---
NEXT_PUBLIC_SITE_URL=https://edav.com.co

# --- Red (solo servidor) ---
# Proxies de confianza delante de la app. Coolify/Traefik = 1. Con Cloudflare delante = 2.
TRUSTED_PROXY_HOPS=1

# --- Last.fm (solo servidor) ---
# Crea la clave en https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=edav404

# --- Formulario de contacto vía SMTP (solo servidor) ---
CONTACT_RECIPIENT=
SMTP_HOST=
# 465 = TLS implícito, 587 = STARTTLS
SMTP_PORT=465
# Opcional: "true" = TLS implícito, "false" = STARTTLS obligatorio. Por defecto: true solo con el puerto 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Por defecto "EDAV OS <SMTP_USER>". Obligatorio si SMTP_USER no es un correo.
SMTP_FROM=

# Copia este archivo como .env.local para desarrollo.
# En producción define estas variables en Coolify (Environment Variables).

# --- Público (se incrusta en el build; en Coolify márcala como "Build Variable") ---
NEXT_PUBLIC_SITE_URL=https://edav.com.co

# --- Red (solo servidor) ---
# De dónde sale la IP del cliente para el rate limit. Antes de tocarlo lee docs/seguridad-proxies.md.
# Vacío (o x-forwarded-for) = X-Forwarded-For contando TRUSTED_PROXY_HOPS desde el final (por defecto).
# cf-connecting-ip = Cloudflare delante (nube naranja o Tunnel). SOLO si el origen no es alcanzable sin
#   pasar por Cloudflare (80/443 cerrados o limitados a sus rangos); si no, la IP es falsificable.
# x-real-ip = la escribe un proxy propio de confianza que la sobrescribe siempre.
CLIENT_IP_HEADER=
# Solo con X-Forwarded-For: proxies de confianza delante de la app. Solo Coolify/Traefik = 1.
# 2 únicamente si Traefik confía en el salto anterior (forwardedHeaders.trustedIPs); si no, todos los
# visitantes acaban en el mismo contador.
TRUSTED_PROXY_HOPS=1

# --- Last.fm (solo servidor) ---
# Crea la clave en https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_USERNAME=edav404

# --- Formulario de contacto vía SMTP (solo servidor) ---
CONTACT_RECIPIENT=
SMTP_HOST=
# 465 = TLS implícito, 587 = STARTTLS
SMTP_PORT=465
# Opcional: "true" = TLS implícito, "false" = STARTTLS obligatorio. Por defecto: true solo con el puerto 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Por defecto "EDAV OS <SMTP_USER>". Obligatorio si SMTP_USER no es un correo.
SMTP_FROM=
